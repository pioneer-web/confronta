# -----------------------------------------------------------------------------
# CONFRONTA UNIFICADO — SaaS + Manage no mesmo projeto
# Copie para .env e ajuste apenas as credenciais/segredos do ambiente.
# -----------------------------------------------------------------------------
DJANGO_SECRET_KEY=troque-esta-chave-local-confronta
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

POSTGRES_DB=dbconfronta
POSTGRES_USER=confronta
POSTGRES_PASSWORD=troque-esta-senha-local
POSTGRES_HOST=db
POSTGRES_PORT=5432


# Área interna dos lotes enviados pelo painel. Web e worker compartilham o
# volume Docker manage_batches; import_inbox fica reservado à entrada externa.
BATCH_STORAGE_DIR=/app/manage_batches
BATCH_RECOVERY_DIR=/app/import_inbox/.manage_batches/recovery
BATCH_LEGACY_STORAGE_DIR=/app/manage_batches_legacy

DJANGO_SUPERUSER_EMAIL=admin@confronta.local
DJANGO_SUPERUSER_PASSWORD=troque-esta-senha-de-admin
DJANGO_SUPERUSER_FIRST_NAME=Super
DJANGO_SUPERUSER_LAST_NAME=Administrador

MAX_UPLOAD_SIZE_BYTES=2147483648
MAX_ZIP_ENTRIES=10000
MAX_ZIP_EXPANSION_RATIO=200
MAX_ZIP_UNCOMPRESSED_BYTES=21474836480
AUTO_REPAIR_INVALID_GEOMETRIES=true
STRICT_GEOMETRY_VALIDATION=true
ANTIVIRUS_ENABLED=false
REQUIRE_ANTIVIRUS=false
ANTIVIRUS_COMMAND=clamscan --no-summary
DJANGO_SECURE_COOKIES=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_TRUST_PROXY_HEADERS=false
DJANGO_COLLECTSTATIC=false

# -----------------------------------------------------------------------------
# SINCRONIZAÇÕES AUTOMÁTICAS
# SICAR permanece manual. IBAMA usa o worker source_monitor.
# -----------------------------------------------------------------------------
SOURCE_AUTOMATION_USER_EMAIL=COLOQUE_O_MESMO_EMAIL_DO_SUPERUSUARIO
SOURCE_DOWNLOAD_TIMEOUT_SECONDS=7200
SOURCE_HTTP_RETRIES=3
SOURCE_HTTP_RETRY_BACKOFF_SECONDS=2

# IBAMA — Termos de Embargo: diário às 05:00 + botão Atualizar agora
# v0.4 usa arquivos oficiais em lote do Dados Abertos.
IBAMA_AUTOMATION_ENABLED=true
IBAMA_AUTOMATION_HOUR=5
IBAMA_AUTOMATION_MINUTE=0
IBAMA_TERMO_EMBARGO_URL=https://dadosabertos.ibama.gov.br/dados/SIFISC/termo_embargo/termo_embargo/termo_embargo_csv.zip
IBAMA_COORDENADAS_URL=https://dadosabertos.ibama.gov.br/dados/SIFISC/termo_embargo/coordenadas/coordenadas.csv
IBAMA_HISTORICO_URL=https://dadosabertos.ibama.gov.br/dados/SIFISC/termo_embargo/termo_embargo_historico/termo_embargo_historico.csv
IBAMA_WKT_API_ENABLED=true
IBAMA_WKT_API_URL_TEMPLATE=http://corpgateway-api.ibama.gov.br/sicafiservicecorp/api/v1/public/termo/consultar/embargos/wkt?seqTad={seq_tad}
IBAMA_WKT_API_MAX_REQUESTS=5000
IBAMA_CSV_CHUNK_SIZE=5000
IBAMA_MAX_MAIN_CSV_BYTES=2147483648

# INCRA automático legado fica desabilitado no catálogo unificado atual.
INCRA_AUTOMATION_ENABLED=false
INCRA_AUTOMATION_HOUR=5
INCRA_AUTOMATION_MINUTE=30
INCRA_SIGEF_URL_TEMPLATE=https://certificacao.incra.gov.br/csv_shp/zip/Sigef%20Brasil_{uf}.zip
INCRA_SNCI_URL_TEMPLATE=https://certificacao.incra.gov.br/csv_shp/zip/Im%C3%B3vel%20certificado%20SNCI%20Brasil_{uf}.zip

# -----------------------------------------------------------------------------
# ÁREA CLIENTE — consultas territoriais
# -----------------------------------------------------------------------------
PUBLIC_MAX_REQUEST_BODY_BYTES=65536
QUERY_GEOMETRY_MAX_UPLOAD_BYTES=5242880
QUERY_GEOMETRY_MAX_BODY_BYTES=2097152
TERRITORIAL_QUERY_TIMEOUT_MS=120000
CAR_LOOKUP_RATE_LIMIT_5MIN=60
CAR_LOOKUP_IP_RATE_LIMIT_5MIN=120


# -----------------------------------------------------------------------------
# ASAAS — use SANDBOX durante a homologação. Nunca versione a chave real.
# -----------------------------------------------------------------------------
ASAAS_ENVIRONMENT=sandbox
# A chave Asaas começa com $. No Docker Compose, use aspas simples.
ASAAS_API_KEY=''
ASAAS_WEBHOOK_TOKEN=''
ASAAS_API_BASE_URL=
ASAAS_USER_AGENT=CONFRONTA/1.0 billing
ASAAS_HTTP_TIMEOUT=25
ASAAS_CHECKOUT_EXPIRES_MINUTES=60
# Obrigatório ao testar Checkout local: URL HTTPS pública do túnel, sem / final.
ASAAS_CALLBACK_BASE_URL=
BILLING_GRACE_DAYS=5
